{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@aibridge/contracts": ["packages/contracts/src/index.ts"],
      "@aibridge/core": ["packages/core/src/index.ts"],
      "@aibridge/host-sdk": ["packages/host-sdk/src/index.ts"],
      "@aibridge/runtime": ["packages/runtime/src/index.ts"],
      "@aibridge/provider-openai-compatible": ["packages/provider-openai-compatible/src/index.ts"],
      "@aibridge/provider-openai": ["packages/provider-openai/src/index.ts"],
      "@aibridge/provider-deepseek": ["packages/provider-deepseek/src/index.ts"],
      "@aibridge/provider-xiaomi-tokenplan": ["packages/provider-xiaomi-tokenplan/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
